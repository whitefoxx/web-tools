{
  "manifest_version": 3,
  "name": "localmd Connect - Browser Superpowers",
  "version": "0.2.0",
  "key": "",
  "description": "Companion for localmd.app - browser tools, page capture and site scripts for your in-browser AI agent.",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "cookies",
    "downloads",
    "userScripts",
    "contextMenus"
  ],
  "optional_permissions": [
    "bookmarks",
    "history",
    "readingList",
    "sessions"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/localmd-connect-16.png",
    "32": "icons/localmd-connect-32.png",
    "48": "icons/localmd-connect-48.png",
    "128": "icons/localmd-connect-128.png"
  },
  "background": {
    "service_worker": "src/background/localmd-connect-service-worker.ts",
    "type": "module"
  },
  "action": {
    "default_title": "localmd Connect",
    "default_popup": "src/localmd-connect/popup.html"
  },
  "options_ui": {
    "page": "src/localmd-connect/options.html",
    "open_in_tab": true
  },
  "commands": {
    "clip-page": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Clip this page to localmd"
    },
    "ask-localmd": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Ask localmd about this page"
    },
    "screenshot-region": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Screenshot a region to localmd"
    },
    "screenshot-page": {
      "description": "Capture the whole page to localmd"
    }
  },
  "minimum_chrome_version": "138"
}
