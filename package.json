{
  "name": "web-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open base for the agent-free browser shells: WebCLI + localmd Connect. The full Web Agent extension (private) depends on this repo as a git submodule.",
  "scripts": {
    "dev": "vite",
    "build:webcli": "vite build --mode webcli",
    "build:webcli:dev": "vite build --mode webcli-dev",
    "build:localmd": "vite build --mode localmd",
    "build:localmd:dev": "vite build --mode localmd-dev",
    "build:all": "pnpm run build:webcli && pnpm run build:localmd",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test",
    "pack:webcli": "node scripts/pack-store.mjs webcli",
    "pack:localmd": "node scripts/pack-store.mjs localmd"
  },
  "dependencies": {
    "dompurify": "3.4.7",
    "marked": "18.0.4",
    "preact": "10.29.2",
    "turndown": "7.2.4"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.4.0",
    "@eslint/js": "10.0.1",
    "@preact/preset-vite": "2.10.5",
    "@types/chrome": "0.0.287",
    "@types/dompurify": "3.0.5",
    "@types/node": "25.9.1",
    "@types/turndown": "5.0.6",
    "eslint": "10.4.0",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
    "prettier": "3.8.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.60.0",
    "vite": "5.4.21",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "rollup": "4.60.4",
      "postcss": "8.5.15",
      "lightningcss": "1.32.0"
    }
  }
}
