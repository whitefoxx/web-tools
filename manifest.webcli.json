{
  "manifest_version": 3,
  "name": "WebCLI - Browser Control for Agents",
  "version": "0.4.0",
  "key": "",
  "description": "Headless bridge exposing your logged-in Chrome as browser tools for CLI AI agents like Claude Code and Codex.",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "scripting",
    "userScripts",
    "storage",
    "cookies",
    "downloads",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background/webcli-service-worker.ts",
    "type": "module"
  },
  "action": {
    "default_title": "WebCLI",
    "default_popup": "src/webcli/popup.html"
  },
  "minimum_chrome_version": "138"
}
